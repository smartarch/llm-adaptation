// Functional Constraints Logic (FCL) with Python predicates
// - within(n, t, `pred`): `pred` holds at least n times within the next t states (t > 0, strict future window)
//                         or within the previous |t| states (t < 0, strict past window)
// - always(formula): the formula holds in every following state (= within(MAX, MAX, formula))
// - forall x in `set`: formula
// - antecedent implies consequent (antecedent: predicate or past within; consequent: predicate or future within)
// - Python sub-expressions are enclosed in backticks `...` and evaluated in the current state

start: formula

?formula: forall
        | always
        | implication
        | within
        | py_expr

forall: "forall" NAME "in" py_expr ":" formula

always: "always" "(" formula ")"

within: "within" "(" num "," num "," py_expr ")"

implication: antecedent "implies" consequent
?antecedent: within | py_expr
?consequent: within | py_expr

?num: SIGNED_INT -> number
    | MAX -> max_const
    | BEG -> beg_const
    | py_expr

// Backtick-delimited Python expression; supports escaping backticks with \`
py_expr: PY_EXPR

PY_EXPR: /`([^`\\]|\\.)*`/

MAX: "MAX"
BEG: "BEG"

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.SIGNED_INT
%import common.WS
%ignore WS

COMMENT: /#[^\n]*/
%ignore COMMENT
