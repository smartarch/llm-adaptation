Config:

example: farm
steps: 300
adaptation_params:
  adapt_every: 10
  config: true
  prompt_template: adaptations.jinja.JinjaPromptTemplate
  prompt_template_params:
    prompt: prompt.jinja
    components:
      Field:
        id: id
        attributes:
          location:
            name: top, bottom, left, right
            description: rectangle
            if: 'lambda component: False'
            hide_in_generate: true
          left:
            name: left
            format: '{:d}'
          top:
            name: top
          right:
            name: right
          bottom:
            name: bottom
          threat_level:
            name: threat level
            format: '{:.2f}'
            description: bird-threat level between 0 and 1
          drones_for_full_protection:
            name: for full protection
            format: '{:d} drones'
          arriving_drones:
            name: flying to field
            format: 'lambda value: f''{value:d} drone{"s" if value != 1 else ""}'''
            description: number of drones flying towards the field to protect it when they arrive
          protecting_drones:
            name: protecting
            format: 'lambda value: f''{value:d} drone{"s" if value != 1 else ""}'''
            description: number of drones currently protecting the field
      Drone:
        id: id
        attributes:
          state:
            name: state
            format: 'lambda value: value.value'
            description: '"idle", "moving_to_field", or "protecting"'
          target_id:
            name: target field
            description: name (str) of the target field, None if drone is idle
            if: 'lambda component: component.state in [DroneState.MOVING_TO_FIELD, DroneState.PROTECTING]'
          location:
            name: location
            description: has `x` and `y` coordinates
    ensembles:
      Idle:
        name: idle
        description: Idle drones don't protect any fields.
      Protecting:
        params:
        - Field
        name: 'lambda field: f"protecting {field.id}"'
        name_str: protecting {field.id}
        description: Assigned drones fly to the field and protect it.
    domain_description: 'You are coordinating a smart farm and must manage a drone fleet that protects crops from birds. The main objective is to minimize crop damage across every field.


      At the start, birds move around the farm randomly. At times they decide to feed, choose a target field, and fly toward it. Their preference over fields changes over time, and they are also more attracted to fields where more birds are already present. After a bird lands in a field, it waits for a fixed period before causing damage. Once damage is dealt, the bird either attacks another crop in the same field or leaves the area.


      Every field has sensors that detect bird presence. A field with more birds reports a higher threat level.


      A drone can be assigned to a target field; it then travels there and hovers above it. Because drone speed is 2, protection starts only after travel time. The drone scares birds within a certain radius, but fully protecting a field requires multiple drones. Scared birds may relocate within the same field and continue feeding. Only when a field is fully protected do birds flee away, so partial protection is not very effective, though still better than no protection.


      Your task is to distribute drones among fields to reduce bird-caused damage as much as possible. You will repeatedly receive the current state (drone positions, threat levels, and similar information) and must assign drones to fields.

      '
    beyond_control_components:
      fields:
        type: Field
        description: Fields on the farm
        access: environment.fields
    assignments:
      assign_drones:
        components:
          type: Drone
          description: Drones
        ensembles:
        - Idle
        - type: Protecting
          foreach: Field
          if: 'lambda field: field.threat_level > 0'
          for_str: field
          in_str: environment.fields
          if_str: field.threat_level > 0
    strategy: ''
    strategy_interface:
      abstract_class: generated_adaptations.base_classes.farm.FarmAdaptation
      class: SmartFarmAdaptation
    chain_of_thought: true
    answer_format: component-first
    drone_attributes:
      battery: false
  max_retries: 1
  llm: gpt-4o-mini-2024-07-18
