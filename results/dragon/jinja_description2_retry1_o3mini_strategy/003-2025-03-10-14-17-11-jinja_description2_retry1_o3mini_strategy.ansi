Config:

example: dragon
steps: 30
log_dir: ../0310/logs/dragon/jinja_description2_retry1_o3mini_strategy
wheat: 10
farmers: 2
warriors: 1
farmer:
  HP: 4
  Attack: 1
  Farming: 5
  SpawnCost: 10
warrior:
  HP: 6
  Attack: 3
  Farming: 2
  SpawnCost: 12
dragon:
  HP: 50
  FireAttackProb: 0.4
  EatAttackProb: 0.2
name: jinja_description2_retry1_o3mini_strategy
adaptation_params:
  config: true
  prompt_template: adaptations.jinja.JinjaPromptTemplate
  prompt_template_params:
    components:
      Dragon:
        attributes:
          hp:
            name: Health
      Farm:
        attributes:
          wheat:
            name: Current wheat amount
      Villager:
        id: name
        attributes:
          role:
            name: Role
            description: '"Farmer" or "Warrior"'
          hp:
            name: Health
    ensembles:
      Farm:
        name: farm
        description: Stay in the Village and work on the farm
      GoToCave:
        name: cave
        description: Go to the Cave
      SpawnFarmer:
        name: spawn farmer
        description: For every two villagers assigned to this group and 10 wheat, a new Farmer is spawned.
      SpawnWarrior:
        name: spawn warrior
        description: For every two villagers assigned to this group and 12 wheat, a new Warrior is spawned.
      Attack:
        name: attack
        description: Attack the Dragon
      StayInCave:
        name: cave
        description: Stay in the Cave
      GoToVillage:
        name: village
        description: Go to the Village
    domain_description: 'You play a computer game. The goal is to kill a Dragon as fast as possible.

      The Dragon lives in a Cave near a Village. The player controls villagers. The villagers can either be in the Village and work on a farm (and produce wheat) or they can go to the Cave, where they can attack the Dragon.

      There are two types of villagers - farmers and warriors. Farmers produce more wheat when they work on a farm, and warriors deal more damage to the Dragon. Farmers start with 4 HP, produce 5 wheat when farming, and deal 1 damage when attacking. Warriors start with 6 HP, produce 2 wheat when farming, and deal 3 damage when attacking.

      To spawn a new villager, at least two villagers must be in the "spawn" group and some wheat is consumed (12 for warriors, 10 for farmers).

      When the Dragon is attacked, it can attack back. With 40% probability, it will cause 1 damage to every villager in the Cave, and with 20% probability, it will eat one random villager in the Cave. Dead villagers are removed from the game. If all the villagers die, you lose the game.

      The Dragon starts with 50 HP and you win the game when it dies. If you don''t kill the Dragon within 30 steps, you lose the game. This is step {}.

      '
    beyond_control_components:
      dragon:
        type: Dragon
        singleton: true
        description: The Dragon
        access: environment.dragon
      farm:
        type: Farm
        singleton: true
        description: The Farm
        access: environment.farm
    assignments:
      assign_in_village:
        components:
          type: Villager
          if: 'lambda component: component.location == Map.VILLAGE'
          description: Villagers in the Village
        ensembles:
        - Farm
        - GoToCave
        - SpawnFarmer
        - SpawnWarrior
      assign_in_cave:
        components:
          type: Villager
          if: 'lambda component: component.location == Map.CAVE'
          description: Villagers in the Cave
        ensembles:
        - Attack
        - StayInCave
        - GoToVillage
    strategy: All Warriors should go to the Cave, and then attack the Dragon. All Farmers should stay in Village and spawn new villagers (if we have enough wheat) or farm.
    strategy_interface:
      abstract_class: generated_adaptations.base_classes.dragon.DragonHuntAdaptation
      class: SmartAdaptation
    chain_of_thought: false
    answer_format: component-first
    step: true
  max_retries: 1
  llm: o3-mini-2025-01-31
  temperature: 1
adaptation_name: adaptations.openai.OpenAIAdaptation
log_file_name: 003-2025-03-10-14-17-11-jinja_description2_retry1_o3mini_strategy
log_file_path: ../0310/logs/dragon/jinja_description2_retry1_o3mini_strategy/003-2025-03-10-14-17-11-jinja_description2_retry1_o3mini_strategy.ansi


